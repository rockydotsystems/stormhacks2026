# Runtime secrets for local Workers development. Copy to .dev.vars, never commit it.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# Public endpoint used in personal MCP setup commands. Must match the MCP Worker's resource URL.
MCP_RESOURCE_URL=http://localhost:3001/mcp

# AI provider. The model adapter reads these. Names are provisional until reconciled with the team.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash

# Speech provider (voice mode).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# GitHub App integration. See docs/github-integration.md.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Double-quoted PEM with escaped newlines, or a quoted multiline PEM.
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Jev (TypeSafe System One) decides when people in a standby discussion have agreed.
# Without a key, standby still works and a person presses Apply instead.
TYPESAFE_API_KEY=
# Optional. Pinned to a model version in code, because the alias moves with each release.
TYPESAFE_MODEL=

# Runtime secrets for local Workers development. Copy to .dev.vars, never commit it.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# AI provider. The model adapter reads these. Names are provisional until reconciled with the team.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash

# Speech provider (voice mode).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

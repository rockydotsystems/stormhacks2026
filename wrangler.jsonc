{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stormhacks2026",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "whydidwechoosethis.tech",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // PlanetScale Postgres; query caching is disabled for read-after-write consistency.
      "id": "bf80c69856e7404faf3d55e5b5d29a82",
      "localConnectionString": "postgres://stormhacks:stormhacks@127.0.0.1:5432/stormhacks",
    },
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
}

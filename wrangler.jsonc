{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stormhacks2026",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Local-only placeholder. Replace with your account's Hyperdrive ID before deploying.
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://stormhacks:stormhacks@127.0.0.1:5432/stormhacks",
    },
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
}

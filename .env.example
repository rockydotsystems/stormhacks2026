# Local development only. Use managed secrets and a hosted database in production.
DATABASE_URL=postgres://stormhacks:stormhacks@localhost:5432/stormhacks

# Fill these in from your WorkOS staging environment.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# AI provider. Runtime values for Workers live in .dev.vars, see .dev.vars.example.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
